{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "esnext",
      "dom"
    ],
    "sourceMap": true,
    "module": "esnext",
    "types": [
      "cypress",
      "node"
    ]
  },
  "paths": {
    "@/*": [
      "../src/*"
    ],
    "#/*": [
      "../*"
    ]
  },
  "include": [
    "../**/*.ts",
    "**/*.ts"
  ]
}
